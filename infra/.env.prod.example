# ─────────────────────────────────────────────────────────────────────────────
# CondoSync — Variáveis de Ambiente de Produção
# Copie para .env.prod e preencha todos os valores antes de subir os containers.
# NUNCA commite o arquivo .env.prod no git.
# ─────────────────────────────────────────────────────────────────────────────

# ── Domínios ──────────────────────────────────────────────────────────────────
# Domínio principal do app (frontend + API)
APP_DOMAIN=app.condosync.com.br

# Domínio do Keycloak (autenticação)
AUTH_DOMAIN=auth.condosync.com.br

# ── Banco de dados da aplicação ───────────────────────────────────────────────
POSTGRES_USER=condosync
POSTGRES_PASSWORD=troque_esta_senha_forte
POSTGRES_DB=condosync

# ── Keycloak ──────────────────────────────────────────────────────────────────
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=troque_esta_senha_forte_keycloak
KEYCLOAK_DB_PASSWORD=troque_esta_senha_forte_kc_db
KEYCLOAK_CLIENT_ID=main-frontend
# Cliente confidencial p/ Admin API. Gere um secret novo no console Keycloak
# (Clients > condo-backend-admin > Credentials > Regenerate).
KEYCLOAK_ADMIN_CLIENT_ID=condo-backend-admin
KEYCLOAK_ADMIN_CLIENT_SECRET=troque_este_secret_no_keycloak_admin

# URL pública canônica (PWA + API no mesmo domínio/nginx).
PUBLIC_URL=https://app.condosync.com.br
# Só se PWA e API estiverem em hosts diferentes:
# APP_PUBLIC_URL=
# API_PUBLIC_URL=

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=troque_esta_senha_forte_redis

# ── Storage S3-compatible ─────────────────────────────────────────────────────
# Em prod recomendamos AWS S3 ou Cloudflare R2 (não MinIO single-node).
STORAGE_PROVIDER=s3
STORAGE_BUCKET=condosync-files
S3_REGION=us-east-1
# Vazio = AWS S3 nativo. Para R2/MinIO use o endpoint do provedor.
S3_ENDPOINT=
# Endpoint público para URLs assinadas. Vazio = mesmo que S3_ENDPOINT.
S3_PUBLIC_ENDPOINT=
S3_ACCESS_KEY_ID=AKIA...
S3_SECRET_ACCESS_KEY=...
# AWS S3 nativo: false. R2/MinIO: true.
S3_FORCE_PATH_STYLE=false

# ── Message Server (WhatsApp) ─────────────────────────────────────────────────
# API key usada no backend -> message-server e no webhook de retorno.
MESSAGE_SERVER_API_KEY=troque_esta_api_key_message_server
MESSAGE_SERVER_WEBHOOK_SECRET=troque_este_secret_webhook
MESSAGE_SERVER_TIMEOUT_MS=10000
MESSAGE_SERVER_COMPANY_ID=condosync
MESSAGE_SERVER_INSTANCE_NAME=CondoSync
MESSAGE_SERVER_INSTANCE_ID=
MESSAGE_SERVER_LOG_LEVEL=info

# ── Imagens (GHCR) ─────────────────────────────────────────────────────────────
API_IMAGE=ghcr.io/condosync/condosync-api
FRONTEND_IMAGE=ghcr.io/condosync/condosync-frontend
MESSAGE_SERVER_IMAGE=ghcr.io/condosync/condosync-message-server
# Tag padrão para deploy; em produção, sobrescreva com SHA da release.
IMAGE_TAG=latest
# Opcionalmente fixe tags por serviço:
FRONTEND_TAG=
MESSAGE_SERVER_TAG=

# ── Resiliência / observabilidade ─────────────────────────────────────────────
# Throttler global (req por janela / janela em segundos).
THROTTLE_LIMIT=120
THROTTLE_TTL=60
# Nível de log do nestjs-pino.
LOG_LEVEL=info
