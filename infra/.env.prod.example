# ─────────────────────────────────────────────────────────────────────────────
# CondoSync — ÚNICO arquivo de produção (VPS)
#
#   cd infra
#   cp .env.prod.example .env.prod
#   nano .env.prod
#
#   docker compose -f docker-compose.prod.yml -f docker-compose.api.yml \
#     --env-file .env.prod up -d
#
# Não commite `.env.prod`. Pode apagar `.env` na raiz e `backend/.env` na VPS
# se usar só este arquivo.
# ─────────────────────────────────────────────────────────────────────────────

# ═══════════════════════════════════════════════════════════════════════════
# Domínios (nginx + Keycloak + CORS da API)
# ═══════════════════════════════════════════════════════════════════════════
APP_DOMAIN=condosync.duckdns.org
AUTH_DOMAIN=condosync-auth.duckdns.org

# Links públicos (convites, QR portaria, mesmo host app+API)
APP_PUBLIC_URL=https://condosync.duckdns.org
API_PUBLIC_URL=https://condosync.duckdns.org

# O compose monta KEYCLOAK_ISSUER=https://${AUTH_DOMAIN}/realms/main na API.
# Mantenha AUTH_DOMAIN igual ao host do Keycloak (sem /realms/...).

# ═══════════════════════════════════════════════════════════════════════════
# Postgres (app) — usado por postgres + DATABASE_URL da API (via compose)
# ═══════════════════════════════════════════════════════════════════════════
POSTGRES_USER=condosync
POSTGRES_PASSWORD=troque_senha_postgres_forte
POSTGRES_DB=condosync

# ═══════════════════════════════════════════════════════════════════════════
# Redis — usado por redis + REDIS_URL da API (via compose)
# ═══════════════════════════════════════════════════════════════════════════
REDIS_PASSWORD=troque_senha_redis_forte

# ═══════════════════════════════════════════════════════════════════════════
# Keycloak (console admin + banco do KC)
# ═══════════════════════════════════════════════════════════════════════════
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=troque_senha_kc_admin
KEYCLOAK_DB_PASSWORD=troque_senha_kc_db

KEYCLOAK_CLIENT_ID=main-frontend
KEYCLOAK_ADMIN_CLIENT_ID=condo-backend-admin
# Console Keycloak → Clients → condo-backend-admin → Credentials
KEYCLOAK_ADMIN_CLIENT_SECRET=troque_secret_do_keycloak

# ═══════════════════════════════════════════════════════════════════════════
# Storage (Cloudflare R2 ou S3)
# ═══════════════════════════════════════════════════════════════════════════
STORAGE_PROVIDER=s3
STORAGE_BUCKET=condosync-files
S3_REGION=auto
S3_ENDPOINT=https://SEU_ACCOUNT_ID.r2.cloudflarestorage.com
S3_PUBLIC_ENDPOINT=https://SEU_ACCOUNT_ID.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

# ═══════════════════════════════════════════════════════════════════════════
# Message server (WhatsApp) — mesmo valor no backend e no container MS
# ═══════════════════════════════════════════════════════════════════════════
MESSAGE_SERVER_API_KEY=troque_api_key_message_server
MESSAGE_SERVER_WEBHOOK_SECRET=troque_secret_webhook
MESSAGE_SERVER_TIMEOUT_MS=10000
MESSAGE_SERVER_COMPANY_ID=condosync
MESSAGE_SERVER_INSTANCE_NAME=CondoSync
MESSAGE_SERVER_INSTANCE_ID=
MESSAGE_SERVER_LOG_LEVEL=info

# ═══════════════════════════════════════════════════════════════════════════
# Portaria virtual (intercom / WebRTC)
# ═══════════════════════════════════════════════════════════════════════════
# Gerar: openssl rand -hex 32
INTERCOM_GUEST_JWT_SECRET=troque_openssl_rand_hex_32
INTERCOM_GUEST_JWT_TTL_SEC=900
INTERCOM_RING_TIMEOUT_SEC=45
WEBRTC_STUN_URLS=stun:stun.l.google.com:19302
# WEBRTC_TURN_URL=
# WEBRTC_TURN_USERNAME=
# WEBRTC_TURN_CREDENTIAL=

# ═══════════════════════════════════════════════════════════════════════════
# API (throttle / logs) — injetados no container condosync-api
# ═══════════════════════════════════════════════════════════════════════════
THROTTLE_LIMIT=120
THROTTLE_TTL=60
LOG_LEVEL=info

# Imagens: build local na VPS (docker-compose.build.yml). Ver scripts/vps-up.sh

# ── O compose da API define automaticamente (não precisa duplicar aqui) ───
# NODE_ENV=production
# PORT=3000
# DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}
# REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379
# KEYCLOAK_BASE_URL=http://keycloak:8080
# KEYCLOAK_ISSUER=https://${AUTH_DOMAIN}/realms/main
# CORS_ORIGINS=https://${APP_DOMAIN}
# MESSAGE_SERVER_BASE_URL=http://message-server:8080
