# ─────────────────────────────────────────────────────────────────────────────
# CondoSync — `.env` na RAIZ do repositório
#
# Usado pelo Docker Compose (${POSTGRES_PASSWORD}, Keycloak, Redis, nginx…).
# Rode os composes de produção com:
#   cd infra && docker compose -f docker-compose.prod.yml -f docker-compose.api.yml \
#     --env-file ../.env up -d
#
# A API Nest lê **`backend/.env`** (não este arquivo). Senhas de Postgres/Redis
# aqui devem ser as MESMAS usadas em `DATABASE_URL` e `REDIS_URL` no backend.
# ─────────────────────────────────────────────────────────────────────────────

# ── Postgres (app) ───────────────────────────────────────────────────────────
POSTGRES_USER=condosync
POSTGRES_PASSWORD=troque_senha_postgres
POSTGRES_DB=condosync

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=troque_senha_redis

# ── Keycloak (admin console + DB) ────────────────────────────────────────────
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=troque_senha_kc_admin
KEYCLOAK_DB_PASSWORD=troque_senha_kc_db

# Domínios (nginx server_name). Em DuckDNS:
APP_DOMAIN=condosync.duckdns.org
AUTH_DOMAIN=condosync-auth.duckdns.org

# Hostname público do Keycloak (URL completa, com https)
KC_HOSTNAME=https://condosync-auth.duckdns.org

# Usados em overrides do compose (ip-only) e documentação — a API usa backend/.env
APP_PUBLIC_URL=https://condosync.duckdns.org
PUBLIC_URL=https://condosync.duckdns.org
KEYCLOAK_ISSUER=https://condosync-auth.duckdns.org/realms/main
CORS_ORIGINS=https://condosync.duckdns.org

# ── Message server (compose → container message-server) ─────────────────────
MESSAGE_SERVER_API_KEY=troque_api_key_message_server
MESSAGE_SERVER_WEBHOOK_SECRET=troque_secret_webhook
MESSAGE_SERVER_COMPANY_ID=condosync
MESSAGE_SERVER_INSTANCE_NAME=CondoSync
MESSAGE_SERVER_LOG_LEVEL=info

# ── Imagens GHCR (deploy) ───────────────────────────────────────────────────
# API_IMAGE=ghcr.io/seu-user/condosync-api
# IMAGE_TAG=latest
