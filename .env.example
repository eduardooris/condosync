# CondoSync — root .env (somente Docker Compose)
# ─────────────────────────────────────────────────────────────────────────────
# Este arquivo NÃO é lido por backend/frontend/app. Ele só existe pra resolver
# `${VARIAVEL}` dentro dos docker-compose*.yml (interpolação no host).
#
# Configuração da aplicação (DB, S3, Keycloak admin secret, Asaas etc.) fica em:
#   • backend/.env      (NestJS API + workers)
#   • frontend/.env     (Vite build)
#   • condosync-app/.env (Expo)
#
# Como usar:
#   cp .env.example .env
#   # ajuste só as variáveis que aparecem em ${...} nos compose files.
#
# IMPORTANTE: este `.env` está no .gitignore — nunca commite valores reais.

# ── Message Server (Go) ─────────────────────────────────────────────────────
# Usados nos compose files dev/prod para o container do message-server, que
# NÃO carrega backend/.env. Mantenha em sincronia com backend/.env quando
# alterar.
MESSAGE_SERVER_API_KEY=dev-message-server-key
MESSAGE_SERVER_WEBHOOK_SECRET=
MESSAGE_SERVER_TIMEOUT_MS=10000
MESSAGE_SERVER_COMPANY_ID=condosync
MESSAGE_SERVER_INSTANCE_NAME=CondoSync
MESSAGE_SERVER_INSTANCE_ID=

# ── Keycloak issuer público ────────────────────────────────────────────────
# Sobrescreve o default `http://localhost:8080/realms/main` da API em dev.
# Útil ao expor via ngrok/cloudflared (use o URL do tunnel).
# KEYCLOAK_ISSUER=http://localhost:8080/realms/main
