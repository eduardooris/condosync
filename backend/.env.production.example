# ─────────────────────────────────────────────────────────────────────────────
# CondoSync API — `backend/.env` na VPS
#
# Senhas: use as MESMAS do `.env` na raiz do repo (POSTGRES_PASSWORD, REDIS_PASSWORD).
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=production
PORT=3000

DATABASE_URL=postgresql://condosync:MESMA_SENHA_DO_.env_RAIZ@postgres:5432/condosync
TYPEORM_SYNC=false

AUTH_PROVIDER=keycloak
KEYCLOAK_BASE_URL=https://condosync-auth.duckdns.org
KEYCLOAK_REALM=main
KEYCLOAK_ISSUER=https://condosync-auth.duckdns.org/realms/main
KEYCLOAK_INTERNAL_URL=http://keycloak:8080/realms/main
KEYCLOAK_CLIENT_ID=main-frontend
KEYCLOAK_CLIENT_SECRET=
KEYCLOAK_ADMIN_CLIENT_ID=condo-backend-admin
KEYCLOAK_ADMIN_CLIENT_SECRET=SECRET_DO_CLIENTE_ADMIN_NO_KEYCLOAK

PUBLIC_URL=https://condosync.duckdns.org
CORS_ORIGINS=https://condosync.duckdns.org

REDIS_URL=redis://:MESMA_SENHA_REDIS_DO_.env_RAIZ@redis:6379

STORAGE_PROVIDER=s3
STORAGE_BUCKET=condosync-files
S3_REGION=auto
S3_ENDPOINT=https://SEU-ACCOUNT-ID.r2.cloudflarestorage.com
S3_PUBLIC_ENDPOINT=https://SEU-ACCOUNT-ID.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

MESSAGE_SERVER_BASE_URL=http://message-server:8080
MESSAGE_SERVER_API_KEY=MESMA_API_KEY_DO_.env_RAIZ
MESSAGE_SERVER_TIMEOUT_MS=10000
MESSAGE_SERVER_COMPANY_ID=condosync
MESSAGE_SERVER_INSTANCE_NAME=CondoSync
MESSAGE_SERVER_WEBHOOK_SECRET=MESMO_WEBHOOK_SECRET_DO_.env_RAIZ

THROTTLE_LIMIT=120
THROTTLE_TTL=60
LOG_LEVEL=info

INTERCOM_GUEST_JWT_SECRET=openssl_rand_hex_32
INTERCOM_GUEST_JWT_TTL_SEC=900
INTERCOM_RING_TIMEOUT_SEC=45
WEBRTC_STUN_URLS=stun:stun.l.google.com:19302
