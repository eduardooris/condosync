NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/condosync
# Em dev: cria/atualiza o schema automaticamente a partir das entidades.
# Em produção use migrations (`npm run typeorm migration:run`).
TYPEORM_SYNC=true
AUTH_PROVIDER=keycloak

# Keycloak
KEYCLOAK_BASE_URL=http://localhost:8080
KEYCLOAK_REALM=main
# Issuer público (mesmo URL que o frontend usa). Vem dentro do JWT (claim `iss`).
KEYCLOAK_ISSUER=http://localhost:8080/realms/main
# (Opcional) URL interna usada pelo backend p/ falar com o Keycloak quando ele
# está em outra rede (ex.: docker-compose: http://keycloak:8080/realms/main).
# Se vazio, o backend usa o KEYCLOAK_ISSUER acima.
KEYCLOAK_INTERNAL_URL=
KEYCLOAK_CLIENT_ID=main-frontend
KEYCLOAK_CLIENT_SECRET=
# Cliente confidencial usado pelo backend p/ chamar a Admin API (criar usuários,
# atribuir/remover roles, resetar senha). Em prod, gere um secret novo no console
# Keycloak (Clients > condo-backend-admin > Credentials).
KEYCLOAK_ADMIN_CLIENT_ID=condo-backend-admin
KEYCLOAK_ADMIN_CLIENT_SECRET=condo-backend-admin-dev-secret

# URL pública do frontend (sem trailing slash). Usada para montar URLs de convite.
APP_PUBLIC_URL=http://localhost:5173

CORS_ORIGINS=http://localhost:5173,http://localhost:3001

REDIS_URL=redis://127.0.0.1:6379

# ── Storage S3-compatible (AWS S3, MinIO, R2 etc.) ───────────────────────────
STORAGE_PROVIDER=s3
STORAGE_BUCKET=condosync-files
S3_REGION=us-east-1
# Endpoint INTERNO (o que o backend enxerga). Em dev com MinIO local rodando
# fora do docker, use http://localhost:9000. No docker-compose o serviço sobrescreve
# para http://minio:9000.
S3_ENDPOINT=http://localhost:9000
# Endpoint PÚBLICO usado para gerar URLs assinadas que o browser baixa.
# Quando o backend roda dentro do docker e o browser fora, deixe http://localhost:9000.
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
# MinIO exige path-style (true). AWS S3 nativo aceita virtual-hosted (false).
S3_FORCE_PATH_STYLE=true

MESSAGE_SERVER_BASE_URL=http://localhost:8080
MESSAGE_SERVER_API_KEY=
MESSAGE_SERVER_TIMEOUT_MS=10000
MESSAGE_SERVER_COMPANY_ID=condosync
MESSAGE_SERVER_INSTANCE_NAME=CondoSync
# Opcional: quando preenchido, o backend pula o auto-create e usa este ID.
MESSAGE_SERVER_INSTANCE_ID=
# Se definido, valida assinatura X-Signature dos webhooks do message-server.
MESSAGE_SERVER_WEBHOOK_SECRET=

# ── Portaria virtual (intercom / WebRTC) ─────────────────────────────────────
API_PUBLIC_URL=http://localhost:3000
INTERCOM_GUEST_JWT_SECRET=dev-intercom-guest-secret-change-me
INTERCOM_GUEST_JWT_TTL_SEC=900
INTERCOM_RING_TIMEOUT_SEC=45
WEBRTC_STUN_URLS=stun:stun.l.google.com:19302
# WEBRTC_TURN_URL=
# WEBRTC_TURN_USERNAME=
# WEBRTC_TURN_CREDENTIAL=

# ── Asaas (gateway de pagamentos) — ver docs/06_pagamentos_asaas.md ──────────
# Em dev local você só precisa preencher ASAAS_MASTER_API_KEY e
# PAYMENTS_ENCRYPTION_KEY. As demais ficam com default sandbox.
ASAAS_ENV=sandbox
ASAAS_API_BASE_URL=https://sandbox.asaas.com/api/v3
# Cole a apiKey gerada em sandbox.asaas.com (Configurações > Integrações).
# A chave começa com $aact_ — use aspas simples no .env para o bash não interpretar $:
# ASAAS_MASTER_API_KEY='$aact_hmlg_...'
ASAAS_MASTER_API_KEY=
# (Opcional) walletId master — necessário só quando ASAAS_DEFAULT_SPLIT_PERCENT > 0.
ASAAS_SAAS_WALLET_ID=
# URL HTTPS pública apontando para este backend (Asaas → webhook).
# Em dev: rode `ngrok http 3000` e cole aqui (ex.: https://abc.ngrok-free.app).
ASAAS_WEBHOOK_PUBLIC_BASE_URL=
# Kill-switch geral. Mantenha `false` enquanto a feature não estiver pronta.
ASAAS_ACCOUNTS_ENABLED=false
# VPS com NODE_ENV=production + Asaas sandbox: ASAAS_ALLOW_SANDBOX_IN_PROD=true
ASAAS_ALLOW_SANDBOX_IN_PROD=false
# % da SaaS no split. 0 = sem split (100% vai pra subconta do síndico).
ASAAS_DEFAULT_SPLIT_PERCENT=0
ASAAS_REQUEST_TIMEOUT_MS=15000
ASAAS_RETRY_MAX=3
# AES-256 base64 (gere com: `openssl rand -base64 32`). Criptografa a apiKey das
# subcontas Asaas em repouso. NUNCA comite valor real — use vault em produção.
PAYMENTS_ENCRYPTION_KEY=

# --- Docker (docker compose na raiz do repositório) ---
# Com `docker compose up`, DATABASE_URL, REDIS_URL e S3_ENDPOINT são injetados
# pelo compose (postgres, redis e minio com nomes de serviço). Mantenha aqui
# SOMENTE o que o compose não define.
# Crie o arquivo: backend/.env (copiado deste exemplo).
