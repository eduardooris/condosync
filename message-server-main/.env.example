# Runtime
APP_ENV=local
APP_NAME=message-server
LOG_LEVEL=info
HTTP_PORT=8080
HTTP_API_KEY=
SHUTDOWN_TIMEOUT=15s

# Postgres (app tables + whatsmeow session store + outbox)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=wpp_message_server
DB_USER=postgres
DB_PASSWORD=postgres
DB_SSLMODE=disable
DB_MAX_CONNS=10

# Diretorio das migrations SQL aplicadas no boot pelo golang-migrate.
# Vazio = <cwd>/migrations (default em dev). Em container distroless
# defina o path absoluto para onde as migrations foram copiadas.
MIGRATIONS_DIR=

# Kafka
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=message-server
KAFKA_CONSUMER_GROUP=message-server

# Inbound topics (commands the gateway sends to us)
KAFKA_TOPIC_CMD_INSTANCE_CREATE=wpp.cmd.instance.create.v1
KAFKA_TOPIC_CMD_INSTANCE_DELETE=wpp.cmd.instance.delete.v1
KAFKA_TOPIC_CMD_MESSAGE_SEND_TEXT=wpp.cmd.message.send-text.v1

# Outbound topics (events we publish back to the gateway)
KAFKA_TOPIC_EVT_INSTANCE_CREATED=wpp.evt.instance.created.v1
KAFKA_TOPIC_EVT_INSTANCE_QRCODE=wpp.evt.instance.qrcode.v1
KAFKA_TOPIC_EVT_INSTANCE_CONNECTION=wpp.evt.instance.connection.v1
KAFKA_TOPIC_EVT_MESSAGE_RECEIVED=wpp.evt.message.received.v1
KAFKA_TOPIC_EVT_MESSAGE_SENT=wpp.evt.message.sent.v1

# Transport
# kafka = integra via topicos Kafka (padrao legado)
# http  = comandos HTTP + eventos outbound por webhook
TRANSPORT_MODE=kafka

# Webhook outbound (usado quando TRANSPORT_MODE=http)
WEBHOOK_URL=
WEBHOOK_AUTH_TOKEN=
WEBHOOK_SECRET=
WEBHOOK_TIMEOUT=10s

# Outbox relay (G2): controla a goroutine que drena
# message_server.outbox para Kafka. Defaults seguros para producao.
OUTBOX_BATCH_SIZE=100
OUTBOX_POLL_INTERVAL=500ms

# Whatsmeow (G3)
WHATSMEOW_LOG_LEVEL=INFO
WHATSMEOW_DB_SCHEMA=whatsmeow

# Observability (G4)
# Porta do endpoint Prometheus (/metrics). Servidor dedicado, separado do HTTP app.
METRICS_PORT=9090
# OTLP endpoint (gRPC host:port). Vazio = tracing desativado (propagator ainda ativo).
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=message-server
