  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "openapi:pull": "curl -fsSL http://localhost:3000/api/openapi.json -o openapi.json",
    "openapi:types": "openapi-typescript ./openapi.json -o ./src/shared/types/openapi.generated.ts",
    "openapi:sync": "npm run openapi:pull && npm run openapi:types",
