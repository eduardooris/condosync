# Origem da API (sem `/api/v1` — o frontend já adiciona o prefixo).
# Em prod aponte para o domínio público (ex.: https://app.condosync.com.br).
VITE_API_BASE_URL=http://localhost:3000

# Keycloak (provedor de autenticação).
VITE_KEYCLOAK_URL=http://localhost:8080
VITE_KEYCLOAK_REALM=main
VITE_KEYCLOAK_CLIENT_ID=main-frontend
