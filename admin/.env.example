# CondoSync Admin (back-office) — variáveis de ambiente
# ─────────────────────────────────────────────────────────────────────────────
# Copie para `.env.local` e ajuste pra sua máquina:
#   cp .env.example .env.local

# URL do backend NestJS (sem /api/v1 — o client adiciona)
VITE_API_BASE_URL=http://localhost:3000

# Keycloak — reusa o mesmo client `main-frontend` do app principal.
# Esse client tem Direct Access Grants habilitado (password grant) e a tela
# de login do admin é própria, com a marca. Sem redirect.
# A role `master-admin` é checada APÓS o login (no token decodificado).
VITE_KEYCLOAK_URL=http://localhost:8080
VITE_KEYCLOAK_REALM=main
VITE_KEYCLOAK_CLIENT_ID=main-frontend
